  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget { background: #f1f5f9; }

/* ---------- Header (cùng phong cách với cửa sổ chức năng) ---------- */
QFrame#headerBar { background: #0f2a47; }
QFrame#headerBar QLabel { background: transparent; font-family: 'Segoe UI'; }
QLabel#lblAppTitle { color: #ffffff; font-size: 18px; font-weight: bold; }
QLabel#lblBreadcrumb { color: #94a3b8; font-size: 13px; }
QLabel#lblUserName { color: #ffffff; font-size: 13px; font-weight: bold; }
QLabel#lblUserRole { color: #94a3b8; font-size: 11px; }
QFrame#headerBar QLabel#lblAvatar {
    background: #2563eb; color: #ffffff; border-radius: 17px;
    font-size: 14px; font-weight: bold;
}

/* ---------- Sidebar ---------- */
QFrame#sidebarWidget { background: #ffffff; border-right: 1px solid #e2e8f0; }
QFrame#sidebarWidget QLabel { background: transparent; font-family: 'Segoe UI'; }
QLabel#lblNavSection { color: #94a3b8; font-size: 11px; font-weight: bold; }
QFrame#sidebarWidget QFrame#sidebarDivider, QFrame#sidebarWidget QFrame#sidebarDivider2 { background: #e2e8f0; max-height: 1px; min-height: 1px; border: none; }
QFrame#sidebarWidget QPushButton {
    background: transparent; color: #334155; border: none; border-radius: 6px;
    border-left: 3px solid transparent;
    text-align: left; padding: 11px 14px; font-family: 'Segoe UI'; font-size: 14px;
}
QFrame#sidebarWidget QPushButton:hover { background: #f1f5f9; color: #0f172a; }
QFrame#sidebarWidget QPushButton[opened=&quot;true&quot;] { color: #0f172a; font-weight: bold; }
QFrame#sidebarWidget QPushButton[active=&quot;true&quot;] {
    background: #eff6ff; color: #1d4ed8; font-weight: bold; border-left: 3px solid #2563eb;
}
QFrame#sidebarWidget QPushButton#btnExit { color: #b91c1c; }
QFrame#sidebarWidget QPushButton#btnExit:hover { background: #fef2f2; color: #991b1b; }

/* ---------- Content ---------- */
QWidget#contentWidget { background: #f1f5f9; }
QWidget#contentWidget QLabel { background: transparent; font-family: 'Segoe UI'; color: #334155; }
QWidget#contentWidget QLabel#lblPageTitle { font-size: 24px; font-weight: bold; color: #0f172a; }
QWidget#contentWidget QLabel#lblPageDesc { font-size: 13px; color: #64748b; }

QFrame#filterFrame, QFrame#tableFrame {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;
}
QWidget#contentWidget QLabel#lblFilterTitle { font-size: 12px; font-weight: bold; color: #64748b; }
QWidget#contentWidget QLabel#lblFilterTable, QWidget#contentWidget QLabel#lblFilterSearch,
QWidget#contentWidget QLabel#lblFilterColumn, QWidget#contentWidget QLabel#lblFilterEventType,
QWidget#contentWidget QLabel#lblFilterBrand, QWidget#contentWidget QLabel#lblFilterCategory,
QWidget#contentWidget QLabel#lblFilterPriceFrom, QWidget#contentWidget QLabel#lblFilterPriceTo,
QWidget#contentWidget QLabel#lblFilterTimeFrom, QWidget#contentWidget QLabel#lblFilterTimeTo { font-size: 12px; color: #64748b; }

QWidget#contentWidget QLineEdit, QWidget#contentWidget QComboBox,
QWidget#contentWidget QDoubleSpinBox, QWidget#contentWidget QDateTimeEdit {
    background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 0px 10px; min-height: 34px; font-family: 'Segoe UI'; font-size: 13px; color: #0f172a;
}
QWidget#contentWidget QLineEdit:focus, QWidget#contentWidget QComboBox:focus,
QWidget#contentWidget QDoubleSpinBox:focus, QWidget#contentWidget QDateTimeEdit:focus { border: 1px solid #2563eb; }
QWidget#contentWidget QComboBox::drop-down, QWidget#contentWidget QDateTimeEdit::drop-down { border: none; width: 24px; }
QWidget#contentWidget QComboBox QAbstractItemView {
    background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1;
    selection-background-color: #eff6ff; selection-color: #1d4ed8; outline: 0;
}

QWidget#contentWidget QPushButton {
    background: #ffffff; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 0px 16px; min-height: 34px; font-family: 'Segoe UI'; font-size: 13px; font-weight: bold;
}
QWidget#contentWidget QPushButton:hover { background: #f1f5f9; }
QWidget#contentWidget QPushButton:pressed { background: #e2e8f0; }
QWidget#contentWidget QPushButton:disabled { color: #94a3b8; background: #f8fafc; }
QWidget#contentWidget QPushButton#btnAdd, QWidget#contentWidget QPushButton#btnApplyFilter {
    background: #2563eb; color: #ffffff; border: none;
}
QWidget#contentWidget QPushButton#btnAdd:hover, QWidget#contentWidget QPushButton#btnApplyFilter:hover { background: #1d4ed8; }
QWidget#contentWidget QPushButton#btnDelete { color: #b91c1c; border: 1px solid #fecaca; }
QWidget#contentWidget QPushButton#btnDelete:hover { background: #fef2f2; }
QWidget#contentWidget QPushButton#btnFirstPage, QWidget#contentWidget QPushButton#btnPrevPage,
QWidget#contentWidget QPushButton#btnNextPage, QWidget#contentWidget QPushButton#btnLastPage {
    padding: 0px 10px; min-width: 20px;
}

QTableWidget {
    background: #ffffff; alternate-background-color: #f8fafc; border: 1px solid #e2e8f0;
    border-radius: 6px; gridline-color: #f1f5f9; color: #0f172a;
    font-family: 'Segoe UI'; font-size: 13px;
    selection-background-color: #dbeafe; selection-color: #0f172a;
}
QTableWidget::item { padding: 4px 12px; }
QHeaderView { qproperty-defaultAlignment: 'AlignLeft | AlignVCenter'; }
QHeaderView::section {
    background: #f1f5f9; color: #475569; font-weight: bold; border: none;
    border-bottom: 1px solid #e2e8f0; padding: 10px 12px; text-align: left;
}
QWidget#contentWidget QLabel#lblRecordCount, QWidget#contentWidget QLabel#lblSelected,
QWidget#contentWidget QLabel#lblPage { font-size: 12px; color: #64748b; }

/* ---------- Footer ---------- */
QFrame#footerBar { background: #ffffff; border-top: 1px solid #e2e8f0; }
QFrame#footerBar QLabel { background: transparent; color: #64748b; font-family: 'Segoe UI'; font-size: 12px; }</string>
