  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget { background: #f3f4f6; }
QFrame#leftPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2563eb, stop:1 #7c3aed);
}
QFrame#leftPanel QLabel { background: transparent; color: white; }
QLabel#labelBrand { font-family: 'Segoe UI'; font-size: 34px; font-weight: bold; }
QLabel#labelBrandSub { font-family: 'Segoe UI'; font-size: 15px; color: #e0e7ff; }
QFrame#rightPanel { background: white; }
QFrame#rightPanel QLabel { background: transparent; font-family: 'Segoe UI'; font-size: 14px; color: #374151; }
QLabel#labelTitle, QLabel#labelRegTitle { font-size: 28px; font-weight: bold; color: #111827; }
QLabel#labelSubtitle, QLabel#labelRegSubtitle { font-size: 14px; color: #6b7280; }
QLabel#labelLoginMsg, QLabel#labelRegMsg { font-size: 13px; color: #dc2626; }
QLineEdit {
    background: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px;
    padding: 0px 12px; font-family: 'Segoe UI'; font-size: 14px; color: #111827;
}
QLineEdit:focus { border: 2px solid #2563eb; background: white; }
QCheckBox { font-family: 'Segoe UI'; font-size: 13px; color: #4b5563; background: transparent; }
QPushButton { font-family: 'Segoe UI'; font-size: 14px; border-radius: 8px; padding: 0px 16px; }
QPushButton#pushButtonLogin, QPushButton#pushButtonRegister {
    background: #2563eb; color: white; border: none; font-weight: bold;
}
QPushButton#pushButtonLogin:hover, QPushButton#pushButtonRegister:hover { background: #1d4ed8; }
QPushButton#pushButtonLogin:pressed, QPushButton#pushButtonRegister:pressed { background: #1e40af; }
QPushButton#pushButtonExit {
    background: white; color: #374151; border: 1px solid #d1d5db;
}
QPushButton#pushButtonExit:hover { background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; }
QPushButton#pushButtonGoRegister, QPushButton#pushButtonGoLogin {
    background: transparent; color: #2563eb; border: none;
}
QPushButton#pushButtonGoRegister:hover, QPushButton#pushButtonGoLogin:hover { text-decoration: underline; }</string>
