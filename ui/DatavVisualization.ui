<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1200</width><height>860</height></rect></property>
  <property name="minimumSize"><size><width>1000</width><height>700</height></size></property>
  <property name="windowTitle"><string>ML Analytics Platform - Data Visualization</string></property>
  <widget class="QWidget" name="centralwidget"><property name="styleSheet"><string notr="true">QWidget#centralwidget { background: #f1f5f9; }

/* ---------- Header ---------- */
QFrame#headerBar { background: #0f2a47; }
QFrame#headerBar QLabel { background: transparent; font-family: 'Segoe UI'; }
QLabel#lblAppTitle { color: #ffffff; font-size: 18px; font-weight: bold; }
QLabel#lblBreadcrumb { color: #94a3b8; font-size: 13px; }
QLabel#lblUserName { color: #ffffff; font-size: 13px; font-weight: bold; }
QLabel#lblUserRole { color: #94a3b8; font-size: 11px; }
QFrame#headerBar QLabel#lblAvatar {
    background: #2563eb; color: #ffffff; border-radius: 17px;
    font-size: 14px; font-weight: bold;
}

/* ---------- Content ---------- */
QWidget#contentWidget { background: #f1f5f9; }
QWidget#contentWidget QLabel { background: transparent; font-family: 'Segoe UI'; color: #334155; }
QWidget#contentWidget QLabel#lblPageTitle { font-size: 24px; font-weight: bold; color: #0f172a; }
QWidget#contentWidget QLabel#lblPageDesc { font-size: 13px; color: #64748b; }

QFrame#filterFrame { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; }
QWidget#contentWidget QFrame[card="true"] {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;
}
QWidget#contentWidget QLabel#lblFilterTitle { font-size: 12px; font-weight: bold; color: #64748b; }
QWidget#contentWidget QLabel[role="filterLabel"] { font-size: 12px; color: #64748b; }

QWidget#contentWidget QDateEdit, QWidget#contentWidget QComboBox {
    background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 0px 10px; min-height: 34px; font-family: 'Segoe UI'; font-size: 13px; color: #0f172a;
}
QWidget#contentWidget QDateEdit:focus, QWidget#contentWidget QComboBox:focus { border: 1px solid #2563eb; }
QWidget#contentWidget QDateEdit::drop-down, QWidget#contentWidget QComboBox::drop-down { border: none; width: 24px; }
QWidget#contentWidget QComboBox QAbstractItemView {
    background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1;
    selection-background-color: #eff6ff; selection-color: #1d4ed8; outline: 0;
}

QWidget#contentWidget QPushButton {
    background: #ffffff; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 0px 16px; min-height: 34px; font-family: 'Segoe UI'; font-size: 13px; font-weight: bold;
}
QWidget#contentWidget QPushButton:hover { background: #f1f5f9; }
QWidget#contentWidget QPushButton:pressed { background: #e2e8f0; }
QWidget#contentWidget QPushButton#btnApplyFilter { background: #2563eb; color: #ffffff; border: none; }
QWidget#contentWidget QPushButton#btnApplyFilter:hover { background: #1d4ed8; }

/* KPI */
QWidget#contentWidget QLabel[role="kpiTitle"] { font-size: 11px; font-weight: bold; color: #64748b; }
QWidget#contentWidget QLabel[role="kpiValue"] { font-size: 24px; font-weight: bold; color: #0f172a; }
QWidget#contentWidget QLabel[role="kpiNote"]  { font-size: 11px; color: #94a3b8; }

/* Chart cards */
QWidget#contentWidget QLabel[role="chartTitle"] { font-size: 14px; font-weight: bold; color: #0f172a; }
QWidget#contentWidget QLabel[role="chartDesc"]  { font-size: 12px; color: #64748b; }

/* Scroll area */
QScrollArea#scrollViz { border: none; background: transparent; }
QWidget#scrollContents { background: #f1f5f9; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---------- Footer ---------- */
QFrame#footerBar { background: #ffffff; border-top: 1px solid #e2e8f0; }
QFrame#footerBar QLabel { background: transparent; color: #64748b; font-family: 'Segoe UI'; font-size: 12px; }</string></property><layout class="QVBoxLayout" name="mainLayout"><property name="spacing"><number>0</number></property><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><item><widget class="QFrame" name="headerBar"><property name="minimumSize"><size><width>0</width><height>56</height></size></property><property name="maximumSize"><size><width>16777215</width><height>56</height></size></property><layout class="QHBoxLayout" name="headerLayout"><property name="spacing"><number>12</number></property><property name="leftMargin"><number>24</number></property><property name="topMargin"><number>-1</number></property><property name="rightMargin"><number>24</number></property><property name="bottomMargin"><number>-1</number></property><item><widget class="QLabel" name="lblAppTitle"><property name="text"><string>ML Analytics Platform</string></property></widget></item><item><widget class="QLabel" name="lblBreadcrumb"><property name="text"><string>/  Data Visualization</string></property></widget></item><item><spacer name="headerSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item><item><layout class="QVBoxLayout" name="userInfoLayout"><property name="spacing"><number>0</number></property><item><widget class="QLabel" name="lblUserName"><property name="text"><string>admin</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property></widget></item><item><widget class="QLabel" name="lblUserRole"><property name="text"><string>Quản trị viên</string></property><property name="alignment"><set>Qt::AlignRight|Qt: